<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  SCS2 chart-group layout for the JointLevelKFPreFilter per-joint YoVariables (robot: Alex).

  Load it in the SCS2 visualizer: on a chart-panel tab, use the chart menu -> "Load chart
  group..." and select this file.

  Joints: Alex lower body + spine/neck (AlexJointMap.Joints). Left column = filtered
  position q with its 1-sigma covariance envelope; right column = filtered velocity q_dot
  with its envelope. One row per joint.

  Names are partial ("<registrySimpleName>.<variableName>"); SCS2 resolves the registry
  segment as a namespace ending, so the full root.main.<thread>... prefix is not needed.
  NOTE: a joint only produces these variables when its IMU pair is enabled at runtime
  (imuSensorsToUse); rows for a disabled pair simply stay empty.

  Grid: 2 columns (q | q_dot) x 15 rows (one per joint).
-->
<YoChartGroupConfiguration name="JointLevelKF">
    <chartConfigurations>
        <identifier column="0" row="0"/>
        <yoVariables>JointLevelKFPreFilter.jointKF_q_LEFT_HIP_Z</yoVariables>
        <yoVariables>JointLevelKFPreFilter.jointKF_q_LEFT_HIP_Z_upperBound</yoVariables>
        <yoVariables>JointLevelKFPreFilter.jointKF_q_LEFT_HIP_Z_lowerBound</yoVariables>
    </chartConfigurations>
    <chartConfigurations>
        <identifier column="1" row="0"/>
