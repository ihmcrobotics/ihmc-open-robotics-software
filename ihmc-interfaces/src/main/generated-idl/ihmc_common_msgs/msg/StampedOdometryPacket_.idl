#ifndef __ihmc_common_msgs__msg__StampedOdometryPacket__idl__
#define __ihmc_common_msgs__msg__StampedOdometryPacket__idl__

#include "geometry_msgs/msg/./Pose_.idl"
#include "geometry_msgs/msg/./Quaternion_.idl"
module ihmc_common_msgs
{
  module msg
  {
    module dds
    {

      /**
       * This message is part of the IHMC localization module.
       */
      @TypeCode(type="ihmc_common_msgs::msg::dds_::StampedOdometryPacket_")
      struct StampedOdometryPacket
      {
        /**
         * Unique ID used to identify this message, should preferably be consecutively increasing.
         */
        unsigned long long sequence_id;
        geometry_msgs::msg::dds::Pose pose;
        geometry_msgs::msg::dds::Quaternion imu_orientation;
        long long timestamp;
        double confidence_factor;
      };
    };
  };
};

#endif
