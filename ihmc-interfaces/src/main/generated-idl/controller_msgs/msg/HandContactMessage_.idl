#ifndef __controller_msgs__msg__HandContactMessage__idl__
#define __controller_msgs__msg__HandContactMessage__idl__

#include "controller_msgs/msg/./RigidBodyTransformMessage_.idl"
#include "geometry_msgs/msg/./Point_.idl"
#include "geometry_msgs/msg/./Vector3_.idl"
#include "ihmc_common_msgs/msg/./Point2DMessage_.idl"
module controller_msgs
{
  module msg
  {
    module dds
    {
      const octet ROBOT_SIDE_LEFT =
      0;

      const octet ROBOT_SIDE_RIGHT =
      1;


      /**
       * This message is part of the IHMC whole-body controller API.
       * This message commands the controller to brace against the given planar region
       */
      @TypeCode(type="controller_msgs::msg::dds_::HandContactMessage_")
      struct HandContactMessage
      {
        /**
         * Unique ID used to identify this message, should preferably be consecutively increasing.
         */
        unsigned long long sequence_id;
        /**
         * If true it will load the contact point, otherwise the hand will stop bearing load.
         */
        boolean load;
        /**
         * Specifies which hand will execute the trajectory.
         */
        @defaultValue(value=255)
        octet robot_side;
        /**
         * Trajectory duration in seconds
         */
        double trajectory_duration;
        /**
         * Specifies the desired bracing point
         */
        geometry_msgs::msg::dds::Point bracing_point;
        /**
         * Specifies the normal vector of the bracing surface
         */
        geometry_msgs::msg::dds::Vector3 bracing_normal;
        /**
         * Initial support polygon in mid-feet zup frame on contact, to warm start region solved through LP
         */
        sequence<ihmc_common_msgs::msg::dds::Point2DMessage, 18> support_region_in_mid_feet_frame;
        controller_msgs::msg::dds::RigidBodyTransformMessage region_transform;
        sequence<ihmc_common_msgs::msg::dds::Point2DMessage, 50> scaled_convex_hull;
        /**
         * Direction the robot is falling in the x direction
         */
        double fall_direction_x;
        /**
         * Direction the robot is falling in the y direction
         */
        double fall_direction_y;
      };
    };
  };
};

#endif
