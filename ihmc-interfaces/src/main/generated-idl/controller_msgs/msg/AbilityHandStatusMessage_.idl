#ifndef __controller_msgs__msg__AbilityHandStatusMessage__idl__
#define __controller_msgs__msg__AbilityHandStatusMessage__idl__

module controller_msgs
{
  module msg
  {
    module dds
    {
      const octet ROBOT_SIDE_LEFT =
      0;

      const octet ROBOT_SIDE_RIGHT =
      1;


      @TypeCode(type="controller_msgs::msg::dds_::AbilityHandStatusMessage_")
      struct AbilityHandStatusMessage
      {
        /**
         * Specifies the side of the robot of the hand being referred to
         */
        @defaultValue(value=255)
        octet robot_side;
        double finger_positions[6];
      };
    };
  };
};

#endif
