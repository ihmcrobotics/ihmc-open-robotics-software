#ifndef __controller_msgs__msg__ControllerWaypointGoalListMessage__idl__
#define __controller_msgs__msg__ControllerWaypointGoalListMessage__idl__

#include "controller_msgs/msg/./ControllerWaypointGoalMessage_.idl"
module controller_msgs
{
  module msg
  {
    module dds
    {

      /**
       * Input message to queue a sequence of goals for the PDVelocityBasedGoalReacher.
       * Each waypoint is consumed in order; the hold_position flag of the last waypoint
       * determines whether the robot holds position at the final goal.
       */
      @TypeCode(type="controller_msgs::msg::dds_::ControllerWaypointGoalListMessage_")
      struct ControllerWaypointGoalListMessage
      {
        /**
         * Unique ID used to identify this message, should preferably be consecutively increasing.
         */
        unsigned long long sequence_id;
        /**
         * Ordered list of goals to execute in sequence.
         */
        sequence<controller_msgs::msg::dds::ControllerWaypointGoalMessage, 50> waypoints;
      };
    };
  };
};

#endif
