#ifndef __perception_msgs__msg__DetectedDoorOpeningMechanismMessage__idl__
#define __perception_msgs__msg__DetectedDoorOpeningMechanismMessage__idl__

#include "controller_msgs/msg/./RigidBodyTransformMessage_.idl"
module perception_msgs
{
  module msg
  {
    module dds
    {

      /**
       * Message representing the DoorOpeningMechanism
       */
      @TypeCode(type="perception_msgs::msg::dds_::DetectedDoorOpeningMechanismMessage_")
      struct DetectedDoorOpeningMechanismMessage
      {
        string name;
        /**
         * Ordinal of DoorSide
         */
        octet side;
        /**
         * Pose of the opening mechanism.
         * May contain NaN in the position and/or orientation values if unknown.
         */
        controller_msgs::msg::dds::RigidBodyTransformMessage transform_to_world;
      };
    };
  };
};

#endif
