#ifndef __perception_msgs__msg__DetectedDoorMessage__idl__
#define __perception_msgs__msg__DetectedDoorMessage__idl__

#include "geometry_msgs/msg/./Pose_.idl"
#include "ihmc_common_msgs/msg/./InstantMessage_.idl"
#include "ihmc_common_msgs/msg/./UUIDMessage_.idl"
#include "perception_msgs/msg/./DetectedDoorOpeningMechanismMessage_.idl"
#include "perception_msgs/msg/./PlanarRegionMessage_.idl"
module perception_msgs
{
  module msg
  {
    module dds
    {

      /**
       * Message representing a DetectedDoor
       */
      @TypeCode(type="perception_msgs::msg::dds_::DetectedDoorMessage_")
      struct DetectedDoorMessage
      {
        /**
         * UUID of this detection
         */
        ihmc_common_msgs::msg::dds::UUIDMessage detection_uuid;
        /**
         * The opening mechanism
         */
        perception_msgs::msg::dds::DetectedDoorOpeningMechanismMessage opening_mechanism;
        /**
         * Panel pose
         * May contain NaN in the position and/or orientation values if unknown.
         */
        geometry_msgs::msg::dds::Pose panel_pose;
        /**
         * Planar region of the panel
         */
        perception_msgs::msg::dds::PlanarRegionMessage panel_planar_region;
        /**
         * Last detection instant
         */
        ihmc_common_msgs::msg::dds::InstantMessage last_detection_time;
      };
    };
  };
};

#endif
