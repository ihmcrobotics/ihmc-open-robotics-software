#ifndef __perception_msgs__msg__YOLOv8ExecutorSettings__idl__
#define __perception_msgs__msg__YOLOv8ExecutorSettings__idl__

#include "ihmc_common_msgs/msg/./LatestModificationMessage_.idl"
#include "perception_msgs/msg/./YOLOv8ModelSettings_.idl"
module perception_msgs
{
  module msg
  {
    module dds
    {

      /**
       * Settings for the YOLOv8DetectionExecutor class
       */
      @TypeCode(type="perception_msgs::msg::dds_::YOLOv8ExecutorSettings_")
      struct YOLOv8ExecutorSettings
      {
        ihmc_common_msgs::msg::dds::LatestModificationMessage latest_timestamp_modifiable;
        /**
         * List of models to run
         */
        sequence<string, 16> models_to_run;
        /**
         * Settings for each model
         */
        sequence<perception_msgs::msg::dds::YOLOv8ModelSettings, 16> model_settings;
      };
    };
  };
};

#endif
