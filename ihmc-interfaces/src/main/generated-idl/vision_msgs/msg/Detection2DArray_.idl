#ifndef __vision_msgs__msg__Detection2DArray__idl__
#define __vision_msgs__msg__Detection2DArray__idl__

#include "std_msgs/msg/./Header_.idl"
#include "vision_msgs/msg/./Detection2D_.idl"
module vision_msgs
{
  module msg
  {
    module dds
    {

      /**
       * A list of 2D detections, for a multi-object 2D detector.
       */
      @TypeCode(type="vision_msgs::msg::dds_::Detection2DArray_")
      struct Detection2DArray
      {
        std_msgs::msg::dds::Header header;
        /**
         * A list of the detected proposals. A multi-proposal detector might generate
         * this list with many candidate detections generated from a single input.
         */
        sequence<vision_msgs::msg::dds::Detection2D> detections;
      };
    };
  };
};

#endif
