#ifndef __vision_msgs__msg__Point2D__idl__
#define __vision_msgs__msg__Point2D__idl__

module vision_msgs
{
  module msg
  {
    module dds
    {

      /**
       * Represents a 2D point in pixel coordinates.
       * XY matches the sensor_msgs/Image convention: X is positive right and Y is positive down.
       */
      @TypeCode(type="vision_msgs::msg::dds_::Point2D_")
      struct Point2D
      {
        double x;
        double y;
      };
    };
  };
};

#endif
