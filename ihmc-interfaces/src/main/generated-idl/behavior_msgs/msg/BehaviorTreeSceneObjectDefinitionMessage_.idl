#ifndef __behavior_msgs__msg__BehaviorTreeSceneObjectDefinitionMessage__idl__
#define __behavior_msgs__msg__BehaviorTreeSceneObjectDefinitionMessage__idl__

module behavior_msgs
{
  module msg
  {
    module dds
    {
      /**
       * From A towards, backed up by X distance, Zup
       */
      const octet COMPOSITE_FRAME_APPROACH =
      0;

      const octet COMPOSITE_FRAME_HYBRID =
      1;


      /**
       * YOLO:
       * FoundationPose:
       * Door Frame
       * Composite Reference Frame:
       * Approach table
       */
      @TypeCode(type="behavior_msgs::msg::dds_::BehaviorTreeSceneObjectDefinitionMessage_")
      struct BehaviorTreeSceneObjectDefinitionMessage
      {
        /**
         * Object type: YOLO only, FoundationPose, custom frame, or specific heurustic
         */
        octet object_type;
        /**
         * YOLO model name to use
         */
        string yolo_model_name;
        /**
         * Class name to use for the object
         */
        string yolo_class_name;
        /**
         * FoundationPose object type (IsaacROSFoundationPoseObject enum ordinal)
         */
        octet foundation_pose_object_type;
        /**
         * Minimum number of points to detect the post
         */
        unsigned short min_post_points;
        /**
         * Minimum number of point to detect the door recess
         */
        unsigned short min_recess_points;
        /**
         * Composite frame name
         */
        string composite_frame_name;
        /**
         * The name of frame A
         */
        string composite_frame_a;
        /**
         * The name of frame B
         */
        string composite_frame_b;
        /**
         * The type of composite frame
         */
        octet composite_frame_type;
        /**
         * Distance from frame B
         */
        float composite_distance;
        /**
         * Consider the table edge when there are this many points in the capsule
         */
        unsigned short min_capsule_points;
        /**
         * Initial capsule distance to start from robot, tunable to avoid detecting self as the table
         */
        float search_start_x;
      };
    };
  };
};

#endif
