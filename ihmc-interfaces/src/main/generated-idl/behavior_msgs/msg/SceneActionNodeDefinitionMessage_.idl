#ifndef __behavior_msgs__msg__SceneActionNodeDefinitionMessage__idl__
#define __behavior_msgs__msg__SceneActionNodeDefinitionMessage__idl__

#include "behavior_msgs/msg/./ActionNodeDefinitionMessage_.idl"
module behavior_msgs
{
  module msg
  {
    module dds
    {

      @TypeCode(type="behavior_msgs::msg::dds_::SceneActionNodeDefinitionMessage_")
      struct SceneActionNodeDefinitionMessage
      {
        /**
         * Parent definition fields
         */
        behavior_msgs::msg::dds::ActionNodeDefinitionMessage definition;
        /**
         * YOLO model name to use
         */
        string yolo_model_name;
        /**
         * YOLO confidence threshold
         */
        float yolo_confidence_threshold;
        /**
         * YOLO mask threshold
         */
        float yolo_mask_threshold;
        /**
         * Segmentation mask erosion radius
         */
        unsigned short segmentation_mask_erosion_radius;
        /**
         * Threshold for removing outlier points of segmented point cloud
         */
        float outlier_threshold;
        /**
         * FoundationPose object type (enum ordinal)
         */
        octet object_type;
        /**
         * True to use foundation pose, else use a YOLO based detection
         */
        boolean use_foundation_pose;
        /**
         * YOLO models that should be enabled at this point
         */
        sequence<string, 10> enabled_yolo_models;
        /**
         * YOLO classes to ignore
         */
        sequence<octet, 256> ignored_yolo_class_indices;
        /**
         * FoundationPose models that should be enabled at this point
         */
        sequence<octet, 10> enabled_foundation_pose_models;
      };
    };
  };
};

#endif
