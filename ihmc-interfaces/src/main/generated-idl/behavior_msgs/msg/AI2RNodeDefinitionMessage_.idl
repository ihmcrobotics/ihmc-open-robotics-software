#ifndef __behavior_msgs__msg__AI2RNodeDefinitionMessage__idl__
#define __behavior_msgs__msg__AI2RNodeDefinitionMessage__idl__

#include "behavior_msgs/msg/./BehaviorTreeNodeDefinitionMessage_.idl"
#include "controller_msgs/msg/./RigidBodyTransformMessage_.idl"
module behavior_msgs
{
  module msg
  {
    module dds
    {

      @TypeCode(type="behavior_msgs::msg::dds_::AI2RNodeDefinitionMessage_")
      struct AI2RNodeDefinitionMessage
      {
        /**
         * Parent definition fields
         */
        behavior_msgs::msg::dds::BehaviorTreeNodeDefinitionMessage definition;
        /**
         * Randomized Go-To action controls
         */
        boolean randomize_go_to_action;
        boolean randomize_whole_body_action;
        long number_of_randomizations;
        /**
         * Whole body randomization trigger and parameters
         */
        long whole_body_randomization_request_id;
        controller_msgs::msg::dds::RigidBodyTransformMessage right_hand_transform_to_chest;
        controller_msgs::msg::dds::RigidBodyTransformMessage left_hand_transform_to_chest;
        double spine_pitch_degrees;
        double spine_roll_degrees;
        double spine_yaw_degrees;
        controller_msgs::msg::dds::RigidBodyTransformMessage pelvis_transform_to_parent;
        double right_hand_trajectory_duration;
        double left_hand_trajectory_duration;
        double spine_trajectory_duration;
        double pelvis_trajectory_duration;
        long left_hand_mask;
        long right_hand_mask;
        long spine_mask;
        long pelvis_mask;
        double probability_one_enabled;
        double probability_two_enabled;
        double probability_three_enabled;
        double probability_four_enabled;
      };
    };
  };
};

#endif
