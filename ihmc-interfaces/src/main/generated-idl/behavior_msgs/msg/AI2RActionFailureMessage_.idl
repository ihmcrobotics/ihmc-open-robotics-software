#ifndef __behavior_msgs__msg__AI2RActionFailureMessage__idl__
#define __behavior_msgs__msg__AI2RActionFailureMessage__idl__

#include "geometry_msgs/msg/./Point_.idl"
#include "geometry_msgs/msg/./Quaternion_.idl"
module behavior_msgs
{
  module msg
  {
    module dds
    {

      /**
       * For use by external AI to modify the behavior tree and operate behaviors
       */
      @TypeCode(type="behavior_msgs::msg::dds_::AI2RActionFailureMessage_")
      struct AI2RActionFailureMessage
      {
        /**
         * Name of the action that has failed
         */
        string action_name;
        /**
         * Type of the action
         */
        string action_type;
        /**
         * Reference frame of the action
         */
        string action_frame;
        /**
         * Whether the reference frame of the failed action was missing
         */
        boolean missing_frame;
        /**
         * Name of the object the action would collide with in not interrupted (marked as failed)
         */
        string collision_name;
        /**
         * Position tolerance for the action [m]
         */
        double position_tolerance;
        /**
         * Orientation tolerance for the action [deg]
         */
        double orientation_tolerance;
        /**
         * Error in position for the action
         */
        geometry_msgs::msg::dds::Point position_error;
        /**
         * Error in orientation for the action
         */
        geometry_msgs::msg::dds::Quaternion orientation_error;
      };
    };
  };
};

#endif
