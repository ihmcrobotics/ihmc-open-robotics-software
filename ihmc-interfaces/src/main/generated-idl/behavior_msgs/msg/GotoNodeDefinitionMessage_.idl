#ifndef __behavior_msgs__msg__GotoNodeDefinitionMessage__idl__
#define __behavior_msgs__msg__GotoNodeDefinitionMessage__idl__

#include "behavior_msgs/msg/./LeafNodeDefinitionMessage_.idl"
module behavior_msgs
{
  module msg
  {
    module dds
    {
      /**
       * Value of the node to goto ID when we have a name but still need to find the ID
       */
      const long long INVALID =
      -1;

      /**
       * Value of the node to goto ID when the node is simply set to goto the next node (i.e. no-op)
       */
      const long long GOTO_NEXT =
      -2;


      @TypeCode(type="behavior_msgs::msg::dds_::GotoNodeDefinitionMessage_")
      struct GotoNodeDefinitionMessage
      {
        /**
         * Parent definition fields
         */
        behavior_msgs::msg::dds::LeafNodeDefinitionMessage definition;
        /**
         * The ID of the node to goto or one of the invalid or next constants
         */
        long long node_to_goto_id;
      };
    };
  };
};

#endif
