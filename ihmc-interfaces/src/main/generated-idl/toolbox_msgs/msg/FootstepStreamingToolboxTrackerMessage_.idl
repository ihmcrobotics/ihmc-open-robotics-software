#ifndef __toolbox_msgs__msg__FootstepStreamingToolboxTrackerMessage__idl__
#define __toolbox_msgs__msg__FootstepStreamingToolboxTrackerMessage__idl__

#include "geometry_msgs/msg/./Point_.idl"
#include "geometry_msgs/msg/./Quaternion_.idl"
#include "geometry_msgs/msg/./Vector3_.idl"
module toolbox_msgs
{
  module msg
  {
    module dds
    {
      const octet ROBOT_SIDE_LEFT =
      0;

      const octet ROBOT_SIDE_RIGHT =
      1;


      /**
       * This message contains all the information needed to estimate footsteps for the robot based on VR trackers
       */
      @TypeCode(type="toolbox_msgs::msg::dds_::FootstepStreamingToolboxTrackerMessage_")
      struct FootstepStreamingToolboxTrackerMessage
      {
        /**
         * Unique ID used to identify this message, should preferably be consecutively increasing.
         */
        unsigned long long sequence_id;
        /**
         * Specifies which foot/tracker
         */
        @defaultValue(value=255)
        octet side;
        /**
         * The timestamp of the  last read from the tracker
         */
        long long timestamp;
        /**
         * This is the current position of the robot foot frame's origin.
         * The data is assumed to be expressed in world frame.
         */
        geometry_msgs::msg::dds::Point robot_foot_position_in_world;
        /**
         * This is the current orientation of the robot foot frame.
         * The data is assumed to be expressed in world frame.
         */
        geometry_msgs::msg::dds::Quaternion robot_foot_orientation_in_world;
        /**
         * This is the current position of the tracker frame's origin.
         * The data is assumed to be expressed in world frame.
         */
        geometry_msgs::msg::dds::Point current_position_in_world;
        /**
         * This is the current orientation of the tracker frame.
         * The data is assumed to be expressed in world frame.
         */
        geometry_msgs::msg::dds::Quaternion current_orientation_in_world;
        /**
         * Whether the current linear velocity is defined.
         */
        boolean has_current_velocity;
        /**
         * The current linear velocity of the control frame's origin.
         */
        geometry_msgs::msg::dds::Vector3 current_linear_velocity_in_world;
        /**
         * The current angular velocity of the control frame.
         */
        geometry_msgs::msg::dds::Vector3 current_angular_velocity_in_world;
      };
    };
  };
};

#endif
