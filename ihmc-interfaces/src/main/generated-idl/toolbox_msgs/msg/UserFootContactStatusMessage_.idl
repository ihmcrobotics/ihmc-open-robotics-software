#ifndef __toolbox_msgs__msg__UserFootContactStatusMessage__idl__
#define __toolbox_msgs__msg__UserFootContactStatusMessage__idl__

module toolbox_msgs
{
  module msg
  {
    module dds
    {

      /**
       * UserFootContactStatusMessage.msg
       * This message communicates the state of the user's feet as detected by VR trackers.
       * The state is true if the user's foot is considered to be in contact with the ground.
       */
      @TypeCode(type="toolbox_msgs::msg::dds_::UserFootContactStatusMessage_")
      struct UserFootContactStatusMessage
      {
        boolean left_foot_in_contact;
        boolean right_foot_in_contact;
      };
    };
  };
};

#endif
