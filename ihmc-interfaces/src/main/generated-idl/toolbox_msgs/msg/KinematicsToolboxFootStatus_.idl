#ifndef __toolbox_msgs__msg__KinematicsToolboxFootStatus__idl__
#define __toolbox_msgs__msg__KinematicsToolboxFootStatus__idl__

#include "geometry_msgs/msg/./Point_.idl"
#include "geometry_msgs/msg/./Quaternion_.idl"
module toolbox_msgs
{
  module msg
  {
    module dds
    {

      @TypeCode(type="toolbox_msgs::msg::dds_::KinematicsToolboxFootStatus_")
      struct KinematicsToolboxFootStatus
      {
        /**
         * General purpose message normally used to report the solution of a whole-body inverse kinematics solver.
         * Which hand to receive the object
         */
        @defaultValue(value=255)
        octet side;
        /**
         * Legged robot-specific contact information (false if not a legged robot)
         */
        boolean foot_in_contact;
        /**
         * Pose of the foot in world frame
         */
        geometry_msgs::msg::dds::Point desired_foot_position;
        geometry_msgs::msg::dds::Quaternion desired_foot_orientation;
        /**
         * Relative pose of the foot wrt the pelvis frame
         */
        geometry_msgs::msg::dds::Point relative_foot_position_from_pelvis;
        geometry_msgs::msg::dds::Quaternion relative_foot_orientation_from_pelvis;
        /**
         * Relative pose of the foot wrt the pelvis frame at the beginning of a step
         */
        geometry_msgs::msg::dds::Point relative_foot_position_from_pelvis_step_start;
        geometry_msgs::msg::dds::Quaternion relative_foot_orientation_from_pelvis_step_start;
      };
    };
  };
};

#endif
