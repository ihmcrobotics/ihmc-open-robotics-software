#ifndef __toolbox_msgs__msg__FootstepStreamingToolboxOutputStatus__idl__
#define __toolbox_msgs__msg__FootstepStreamingToolboxOutputStatus__idl__

#include "geometry_msgs/msg/./Point_.idl"
#include "geometry_msgs/msg/./Quaternion_.idl"
module toolbox_msgs
{
  module msg
  {
    module dds
    {
      /**
       * Message used to report the computed footstep, which will be placed by the UI
       */
      const octet ROBOT_SIDE_LEFT =
      0;

      const octet ROBOT_SIDE_RIGHT =
      1;


      @TypeCode(type="toolbox_msgs::msg::dds_::FootstepStreamingToolboxOutputStatus_")
      struct FootstepStreamingToolboxOutputStatus
      {
        /**
         * Unique ID used to identify this message, should preferably be consecutively increasing.
         */
        unsigned long long sequence_id;
        /**
         * Specifies which foot
         */
        @defaultValue(value=255)
        octet robot_side;
        /**
         * Desired footstep position in world frame.
         */
        geometry_msgs::msg::dds::Point desired_foot_position;
        /**
         * Desired footstep orientation in world frame.
         */
        geometry_msgs::msg::dds::Quaternion desired_foot_orientation;
      };
    };
  };
};

#endif
